# 로컬 환경 오버라이드 예시.
# 이 파일을 .env로 복사해서 쓴다. .env는 gitignore 대상이다.
#
#   cp .env.example .env
#
# 값을 바꾸는 건 "호스트 포트"뿐이다. 컨테이너끼리는 항상 기본 포트로
# 통신하므로(mysql:3306, rabbitmq:5672 등) 서비스 설정은 건드릴 필요 없다.

# ── 호스트 포트 충돌 회피 ────────────────────────────────
# 호스트에 이미 MySQL/MongoDB가 설치돼 있으면 여기서 바꾼다.
# 확인: Get-NetTCPConnection -LocalPort 3306 -State Listen
#MYSQL_PORT=3307
#MONGO_PORT=27018
#MINIO_PORT=9000
#MINIO_CONSOLE_PORT=9001
#RABBITMQ_PORT=5672
#RABBITMQ_UI_PORT=15672

# ── 자격증명 ──────────────────────────────────────────
# 로컬 개발용 기본값이 compose에 박혀 있다. 운영에서는 반드시 바꾼다.
#MYSQL_ROOT_PASSWORD=root
#MINIO_ROOT_USER=minioadmin
#MINIO_ROOT_PASSWORD=minioadmin
#RABBITMQ_USER=lxp
#RABBITMQ_PASSWORD=lxp

# ── 정기 결제 데모 ────────────────────────────────────
# 주기를 0일로 두면 다음 폴링에서 바로 다음 회차가 청구된다.
#BILLING_PERIOD_DAYS=0
#BILLING_SCHEDULER_INTERVAL_MS=10000

# ── Gemini API (규정 QA 챗봇 D-69 · 커리큘럼 로드맵) ──
# Google AI Studio에서 발급: https://aistudio.google.com/apikey
#
# 이 값만은 config-repo에 두지 않는다. config-repo는 평문 git이고 이 저장소는
# 공개다. 모델명·타임아웃 같은 비-비밀 설정은 config-repo/ai-service.yml에 있다.
#
# 두 서비스가 같은 키를 쓴다. 비워두면 뜨기는 하지만 모델 호출에서 실패한다.
#GEMINI_API_KEY=

# 커리큘럼 로드맵만 읽는다 (compose.curriculum.yaml).
# 무료 한도가 "프로젝트 x 모델"당 하루 20건이라, 다 쓰면 이 줄만 바꾸고
# docker compose -f compose.curriculum.yaml up -d 를 다시 한다. 코드는 안 고친다.
# 지금 도는 모델은 /actuator/health 와 화면 오른쪽 위 배지에 나온다.
GEMINI_MODEL=gemini-3.1-flash-lite

# 한도가 다 찼을 때 갈아탈 목록. 쉼표로 나눠 적는다. 비워두면 위 한 개만 쓴다.
# 429(하루 한도)일 때만 갈아탄다. 5xx 는 모델을 바꿔도 그대로라 안 갈아탄다.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.7-flash
