# 이 파일은 '값이 비어 있는 템플릿'이고 커밋된다.
# 실제 키는 .env 에만 넣는다. (.env 는 gitignore 대상)
#
# 이름을 바꾸지 말고 복사해서 쓴다:
#   cp .env.example .env
#
# 키 값은 이 파일에도, config-repo 에도 절대 넣지 않는다.
# config-repo(ai-service.yml)에는 모델명·타임아웃 같은 비밀이 아닌 설정만 둔다.

# Google AI Studio에서 발급 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 모델은 숫자가 박힌 GA 이름으로 고정한다. `gemini-flash-latest` 같은 별칭은
# 뒤에서 모델이 바뀌어 회차 간 지표 비교가 무효가 되므로 쓰지 않는다.
# gemini-2.5-* 는 신규 사용자에게 제공 종료(404)라 쓸 수 없다.
# 사용 가능한 ID 확인: uv run python scripts/measure_tokens.py --list
GEMINI_MODEL=gemini-3.6-flash

# 한글 출력 깨짐 방지 (Windows 콘솔 코드페이지)
PYTHONUTF8=1
