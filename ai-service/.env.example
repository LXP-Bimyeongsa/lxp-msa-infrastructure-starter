# LXP AI 튜터 — 환경 변수
# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다

# --- 모델 ---
# 4단계(뼈대)에서는 없어도 서버가 뜬다. S1(색인)부터 반드시 필요하다
GEMINI_API_KEY=

# --- 트레이싱 (LangSmith) ---
# 끄고 싶으면 false 로 둔다. 키가 비어 있어도 서버는 뜬다
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lxp-ai-tutor

# --- 임베딩 ---
# 색인과 검색이 같은 모델을 써야 벡터 공간이 맞는다. 바꾸면 전체 재색인이 필요하다
EMBEDDING_MODEL=models/gemini-embedding-001
