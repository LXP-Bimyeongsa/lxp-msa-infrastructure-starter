# 실제 키가 들어간다. .env.example 만 커밋한다
.env

# 가상환경 / 캐시
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.uv-cache/

# 색인과 체크포인터는 산출물이다. 다시 만들 수 있다
data/chroma/
*.sqlite
*.sqlite3

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# 로그
*.log
logs/

# 생성물이다. scripts/build_corpus.py 로 다시 만들 수 있고,
# 원본은 다른 저장소의 학습 자료라 여기 복사본을 커밋하지 않는다
data/raw/courses/

# 퀴즈는 개인 학습 기록이다. 저장소에 올리지 않는다
docs/quiz/

# 체크포인터 저장소. 그래프 재개용이라 다시 만들 수 있다
# sqlite 는 본체 말고 -wal, -shm 도 만든다. 본체만 막으면 1MB 짜리 wal 이 딸려 들어간다
data/checkpoints.sqlite*
